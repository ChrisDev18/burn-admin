generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?
}

model Settings {
  id            Int  @id @default(autoincrement())
  defaultShowId Int?
  offAirShowId  Int?

  defaultShow RadioShow? @relation("DefaultShow", fields: [defaultShowId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  offAirShow  RadioShow? @relation("OffAirShow", fields: [offAirShowId], references: [id], onDelete: SetNull, onUpdate: Cascade)
}

// Radio Shows

model RadioShow {
  id              Int             @id @default(autoincrement())
  title           String
  description     String?
  hosts           String?
  photo           String?
  recordings      Recording[]
  scheduleEntries ScheduleEntry[]
  defaultSettings Settings[]      @relation("DefaultShow")
  offAirSettings  Settings[]      @relation("OffAirShow")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Recording {
  id          Int      @id @default(autoincrement())
  radioShowId Int
  recording   String
  title       String?
  recordedAt  DateTime

  radioShow RadioShow @relation(fields: [radioShowId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

// Scheduling

model Schedule {
  id        Int             @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  entries   ScheduleEntry[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ScheduleEntry {
  id            Int                    @id @default(autoincrement())
  scheduleId    Int
  radioShowId   Int
  day           Day
  startTime     String
  endTime       String
  activeFrom    DateTime?
  activeUntil   DateTime?
  overriding    Boolean // Whether this entry is a one-off and should override any regular event
  cancellations ScheduleCancellation[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  schedule  Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  radioShow RadioShow @relation(fields: [radioShowId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model ScheduleCancellation {
  id              Int      @id @default(autoincrement())
  scheduleEntryId Int
  weekDate        DateTime // A date occuring in the week that this cancellation occurs
  // By default, this would be the date that this show would occur in the week

  scheduleEntry ScheduleEntry? @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum Day {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

// Podcasts

model Podcast {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  hosts       String?
  photo       String?
  term        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
